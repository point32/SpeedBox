<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="变速任务"
            android:textColor="@color/osu_content1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTaskStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="2dp"
            android:text="RUN 45%"
            android:textColor="@color/osu_highlight1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:text="正在处理音频与谱面…"
        android:textColor="@color/osu_content2"
        android:textSize="12sp" />

    <view class="com.speedbox.ui.LazerUi$OsuProgressBarView"
        android:id="@+id/pbTask"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
            android:id="@+id/btnTaskShare"
            android:layout_width="80dp"
            android:layout_height="26dp"
            android:visibility="gone" />

        <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
            android:id="@+id/btnTaskCancel"
            android:layout_width="68dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
