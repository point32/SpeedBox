<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/songCardRoot"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvSongChevron"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivSongCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/songTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="15dp">

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3"
                android:text="Song Title"
                android:textColor="@color/osu_content1"
                android:textSize="15.5sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/tvSongSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="10 个难度 · BPM 160"
                android:textColor="@color/osu_content1"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <view class="com.speedbox.ui.LazerUi$StarSpectrumDotsView"
                android:id="@+id/spreadDots"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
