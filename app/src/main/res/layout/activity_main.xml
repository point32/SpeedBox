<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/osu_bg6">

    <!-- 0. Ambient Beatmap Cover Background (Dimmed) + TrianglesV2 Particle Layer -->
    <ImageView
        android:id="@+id/ivGlobalBgCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:scaleType="centerCrop" />

    <view class="com.speedbox.ui.LazerUi$TrianglesBackgroundView"
        android:id="@+id/trianglesBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. Main SongSelect v2 Content Layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="50dp">

        <!-- 1A. Permission Banner -->
        <LinearLayout
            android:id="@+id/permBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="需要授予所有文件访问权限以自动读写 Malody / osu! 曲库目录"
                android:textColor="@color/osu_content1"
                android:textSize="12sp" />
            <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                android:id="@+id/btnGrantPerm"
                android:layout_width="88dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <!-- 1B. Top-Left BeatmapTitleWedge.cs + Nested DifficultyDisplay.cs (Exact lazer hierarchy) -->
        <LinearLayout
            android:id="@+id/titleWedgeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Top Row: BeatmapSetOnlineStatusPill + Right aligned Subtle Path Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWedgeStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1.5dp"
                    android:text="OSU!MANIA"
                    android:textColor="@color/osu_bg5"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWedgeArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Artist Name"
                    android:textColor="@color/osu_content2"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAutoSyncBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● SYNC"
                    android:textColor="@color/osu_lime"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWedgePath"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Main Title (Large Headliner) -->
            <TextView
                android:id="@+id/tvWedgeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="SpeedBox osu!lazer"
                android:textColor="@color/osu_content1"
                android:textSize="17.5sp"
                android:textStyle="bold|italic" />

            <!-- Nested BeatmapTitleWedge.DifficultyDisplay.cs Sub-Wedge -->
            <LinearLayout
                android:id="@+id/difficultyDisplaySubWedge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingVertical="5dp">

                <!-- Row 1: StarRatingDisplay pill + Difficulty Version Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWedgeStarPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="7.5dp"
                        android:paddingVertical="1.5dp"
                        android:text="★ 4.72"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWedgeVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="选择谱面开始变速"
                        android:textColor="@color/osu_content1"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: Statistic badges (BPM + Lock Pitch Tag) -->
                <LinearLayout
                    android:id="@+id/wedgeStatsInnerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp">

                    <TextView
                        android:id="@+id/tvBpmConvertPreview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="♪ BPM 160 → 184.0 (1.15x) · 已选 0 谱"
                        android:textColor="@color/osu_content1"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPitchPreviewBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="TEMPO 锁音高 · +0 st"
                        android:textColor="@color/osu_lime"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivWedgeCover"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1C. FilterControl.cs Wedge -->
        <LinearLayout
            android:id="@+id/filterWedgeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/searchBoxFrame"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="40dp">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="键入以搜索歌名 / 版本 / BPM…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingEnd="20dp"
                        android:singleLine="true"
                        android:textColor="@color/osu_content1"
                        android:textColorHint="@color/osu_fg1"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/osu_content2"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </FrameLayout>

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/btnImportZip"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/btnSelectCurrentSong"
                    android:layout_width="58dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/btnClearSelection"
                    android:layout_width="48dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/tabFilterAll"
                    android:layout_width="50dp"
                    android:layout_height="24dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/tabFilterSelected"
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/tabFilterMc"
                    android:layout_width="54dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/tabFilterOsu"
                    android:layout_width="48dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/tvLibraryStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text="0 曲 / 0 谱"
                    android:textColor="#FFFFCC22"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1D. Right-Anchored BeatmapCarousel with Curved Scroll Parallax -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ListView
                android:id="@+id/lvCarousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="3dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tvEmptyCarousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="未找到匹配的谱面
可点击底部 [曲库目录] 切换路径或上方 [导入包] 导入外部谱面"
                android:textColor="@color/osu_fg1"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>


    <!-- 2. Overlay Sheet: Task Queue & Diagnostic Logs (Upright Rounded Card, No Parallelogram Distortion!) -->
    <FrameLayout
        android:id="@+id/taskOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50dp"
        android:background="#DC121517"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/taskOverlayCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.05"
                    android:text="TASK QUEUE &amp; LOGS · 任务队列与日志"
                    android:textColor="@color/osu_highlight1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/btnClearDoneTasks"
                    android:layout_width="72dp"
                    android:layout_height="26dp" />

                <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="66dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvTasks"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="运行诊断日志 (自动增量同步与音频变速流水线)"
                android:textColor="@color/osu_fg1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_log_panel"
                android:overScrollMode="never"
                android:padding="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llLogLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- 3. ScreenFooter.cs + ScreenBackButton.cs + Protruding ScreenFooterButtons + OsuLogo Cookie -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:background="@color/osu_bg5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="80dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <view class="com.speedbox.ui.LazerUi$ShearedButtonView"
                android:id="@+id/btnBackExit"
                android:layout_width="54dp"
                android:layout_height="42dp"
                android:layout_marginBottom="4dp" />

            <view class="com.speedbox.ui.LazerUi$FooterButtonView"
                android:id="@+id/footerBtnSettings"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_weight="1.15"
                android:layout_marginStart="4dp" />

            <view class="com.speedbox.ui.LazerUi$FooterButtonView"
                android:id="@+id/footerBtnDir"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_weight="0.95"
                android:layout_marginStart="4dp" />

            <view class="com.speedbox.ui.LazerUi$FooterButtonView"
                android:id="@+id/footerBtnQueue"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_weight="0.95"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <view class="com.speedbox.ui.LazerUi$OsuCookieButtonView"
            android:id="@+id/btnOsuCookieStart"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="2dp" />
    </FrameLayout>

    <!-- 4. osu!lazer SettingsPanel (OverlayColourScheme.Purple) — 变速与输出 -->
    <view class="com.speedbox.ui.SettingsPanelView"
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 5. Global osu!lazer Context Menu Overlay Container (1:1 OsuContextMenuContainer.cs) -->
    <view class="com.speedbox.ui.LazerUi$OsuContextMenuContainer"
        android:id="@+id/osuContextMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
